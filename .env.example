# torvaxo.pk — copy to .env.local and fill in. Every value below is a PLACEHOLDER.
# Never commit .env.local. Server-only secrets must NOT start with NEXT_PUBLIC_.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000          # production: https://torvaxo.pk
APP_SECRET=PLACEHOLDER-long-random-string           # signs internal tokens (openssl rand -hex 32)

# --- Supabase (Project Settings → API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=PLACEHOLDER-https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=PLACEHOLDER-sb_publishable_xxx   # (or legacy NEXT_PUBLIC_SUPABASE_ANON_KEY) admin sign-in only
SUPABASE_SERVICE_ROLE_KEY=PLACEHOLDER-sb_secret_xxx   # Project Settings → API Keys → secret key. Server only!

# --- Payments ----------------------------------------------------------------
# mock = every online payment goes to a built-in approve/decline test screen (no gateway needed)
# live = real Safepay / JazzCash / Easypaisa using the credentials below
PAYMENTS_MODE=mock

# Safepay (getsafepay.com → Developers). Webhook URL: {SITE_URL}/api/payments/safepay/webhook
SAFEPAY_ENVIRONMENT=sandbox                          # sandbox | production
SAFEPAY_API_KEY=PLACEHOLDER-sec_xxx                  # public merchant API key
SAFEPAY_SECRET_KEY=PLACEHOLDER-secret-key
SAFEPAY_WEBHOOK_SECRET=PLACEHOLDER-webhook-shared-secret

# JazzCash (sandbox.jazzcash.com.pk merchant portal). Return URL: {SITE_URL}/api/payments/jazzcash/return
JAZZCASH_ENVIRONMENT=sandbox                         # sandbox | production
JAZZCASH_MERCHANT_ID=PLACEHOLDER-MC00000
JAZZCASH_PASSWORD=PLACEHOLDER-password
JAZZCASH_INTEGRITY_SALT=PLACEHOLDER-salt

# Easypaisa / Easypay (merchant portal). Postback: {SITE_URL}/api/payments/easypaisa/return
# IPN listener: {SITE_URL}/api/payments/easypaisa/webhook
EASYPAISA_ENVIRONMENT=sandbox                        # sandbox | production
EASYPAISA_STORE_ID=PLACEHOLDER-store-id
EASYPAISA_HASH_KEY=PLACEHOLDER-16-char-hash-key
# Order-status REST URL from the Easypay portal, with {orderId} where the order reference goes
EASYPAISA_STATUS_URL=PLACEHOLDER-https://easypay.easypaisa.com.pk/easypay-service/rest/.../{orderId}

# --- Email (resend.com). Without a key, emails are logged to the server console.
RESEND_API_KEY=PLACEHOLDER-re_xxx
EMAIL_FROM=Torvaxo Pakistan <orders@torvaxo.pk>
ADMIN_NOTIFY_EMAIL=                                  # optional: gets a copy of every new order
